		"2amigos/yii2-google-maps-library": "*",
		"zelenin/yii2-rss": "~0.1",
		"skeeks/yii2-assets-auto-compress": "*",
	    "openspout/openspout": "^4.28",
		"phpoffice/phpspreadsheet": "^1.7",
		"jeroendesloovere/vcard": "dev-2.0.0-dev",
		"richweber/yii2-google-translate-api": "dev-master",
		"2amigos/qrcode-library": "^2.0",
	    "stripe/stripe-php": "*",
	    "borales/yii2-phone-input": "*",

	  	"axcorpo/textfile": "dev-main",
		"axcorpo/yii2": "dev-main",
		"axcorpo/yii2-payment": "dev-main",
	    "axcorpo/yii2-commercial": "dev-main",
		"axcorpo/yii2-widget-sitemap": "dev-main",
		"axcorpo/yii2-widget-carousel": "dev-main",
		"axcorpo/yii2-widget-chart": "dev-main",
		"axcorpo/yii2-widget-datetimepicker": "dev-main",
		"axcorpo/yii2-widget-socialshare": "dev-main",
		"axcorpo/yii2-widget-sortable": "dev-main",
		"axcorpo/yii2-widget-tinymce": "dev-main",
		"axcorpo/yii2-widget-typeahead": "dev-main",

		"npm-asset/font-awesome": "~4.7.0",
		"npm-asset/simple-line-icons": "~2.4.1",
		"npm-asset/animate.css": "~3.7.2",
		"npm-asset/iframe-resizer": "~4.2.6",
		"npm-asset/fancyapps--fancybox": "~3.5.7",
		"ramsey/uuid": "^4.9",
		"cebe/yii2-loki-log-target": "^1.2"
	},
	"require-dev": {
		"yiisoft/yii2-debug": "~2.0.0",
		"yiisoft/yii2-gii": "^2.2.7",
		"yiisoft/yii2-faker": "~2.0.0",
		"codeception/codeception": "^5.0",
		"phpunit/phpunit": "^9.5 || ^10.0",
		"codeception/verify": "^2.0"
	},
	"config": {
	  "process-timeout": 1800,
	  "platform-check": false,
	  "allow-plugins": {
		"yiisoft/yii2-composer": true
	  },
	  "audit": {
		"block-insecure": false
	  }
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://asset-packagist.org"
		},
		{
			"type": "package",
			"package": {
				"name": "2amigos/yii2-google-maps-library",
				"version": "1.1.9",
				"dist": {
					"type": "zip",
					"url": "https://github.com/2amigos/yii2-google-maps-library/archive/refs/tags/1.1.9.zip"
				},
				"require": {
					"yiisoft/yii2": "*",
					"guzzlehttp/guzzle": "^7.9"
				},
				"autoload": {
					"psr-4": {"dosamigos\\google\\maps\\": ""}
				}
			}
		},
	  	{"type": "vcs", "url": "git@github.com:axcorpo/textfile.git"},
		{"type": "vcs", "url": "git@github.com:axcorpo/yii2.git"},
		{"type": "vcs", "url": "git@github.com:axcorpo/yii2-payment.git"},
	    {"type": "vcs", "url": "git@github.com:axcorpo/yii2-commercial.git"},
		{"type": "vcs", "url": "git@github.com:axcorpo/yii2-widget-sitemap.git"},
		{"type": "vcs", "url": "git@github.com:axcorpo/yii2-widget-carousel.git"},
		{"type": "vcs", "url": "git@github.com:axcorpo/yii2-widget-chart.git"},
		{"type": "vcs", "url": "git@github.com:axcorpo/yii2-widget-datetimepicker.git"},
		{"type": "vcs", "url": "git@github.com:axcorpo/yii2-widget-socialshare.git"},
		{"type": "vcs", "url": "git@github.com:axcorpo/yii2-widget-sortable.git"},
		{"type": "vcs", "url": "git@github.com:axcorpo/yii2-widget-tinymce.git"},
		{"type": "vcs", "url": "git@github.com:axcorpo/yii2-widget-typeahead.git"}
	]
}
