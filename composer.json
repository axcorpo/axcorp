		"tws",
		"saas",
		"master"
	],
	"homepage": "https://www.treewebsolutions.com/",
	"authors": [
		{
			"name": "Tree Web Solutions",
			"email": "treewebsolutions.com@gmail.com"
		}
	],
	"type": "project",
	"license": "BSD-3-Clause",
	"support": {
		"issues": "https://github.com/yiisoft/yii2/issues?state=open",
		"forum": "http://www.yiiframework.com/forum/",
		"wiki": "http://www.yiiframework.com/wiki/",
		"irc": "irc://irc.freenode.net/yii",
		"source": "https://github.com/yiisoft/yii2"
	},
	"minimum-stability": "stable",
	"require": {
		"php": ">=8.1.0",
		"yiisoft/yii2": "~2.0.21",
		"yiisoft/yii2-bootstrap": "~2.0.0",
		"bower-asset/bootstrap": "^3.4.1",
		"yiisoft/yii2-symfonymailer": "^4.0",
		"yiisoft/yii2-httpclient": "~2.0.0",
		"yii2tech/ar-softdelete": "*",
		"yii2tech/ar-position": "^1.0",
		"omnilight/yii2-scheduling": "*",
		"lajax/yii2-translate-manager": "^1.7",
		"codemix/yii2-localeurls": "^1.7",
		"kartik-v/yii2-dialog": "@dev",
		"kartik-v/yii2-widget-growl": "*",
		"kartik-v/yii2-widget-depdrop": "@dev",
		"kartik-v/yii2-widget-select2": "@dev",
		"kartik-v/yii2-widget-colorinput": "*",
		"kartik-v/yii2-widget-fileinput": "@dev",
		"kartik-v/yii2-widget-switchinput": "*",
		"kartik-v/yii2-widget-typeahead": "*",
